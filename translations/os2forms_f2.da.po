msgctxt "os2forms_f2"
msgid "F2 API"
msgstr "F2-api"

msgctxt "os2forms_f2"
msgid "General"
msgstr "Generelt"

msgctxt "os2forms_f2"
msgid "Ping API"
msgstr "Tjek forbindelse til api"

msgctxt "os2forms_f2"
msgid "Note: Pinging the API will use saved config."
msgstr "Bemærk: Forbindelsen bliver tjekket med de gemte indstillinger."

msgctxt "os2forms_f2"
msgid "URI"
msgstr "Url"

msgctxt "os2forms_f2"
msgid "The F2 API base URI"
msgstr "F2-api'ets base-url"

msgctxt "os2forms_f2"
msgid "Username"
msgstr "Bruger"

msgctxt "os2forms_f2"
msgid "The F2 API username"
msgstr "F2-api-brugernavnet"

msgctxt "os2forms_f2"
msgid "Secret"
msgstr "Hemmelighed (secret)"

msgctxt "os2forms_f2"
msgid "The F2 API secret"
msgstr "F2-api-hemmeligheden"

msgctxt "os2forms_f2"
msgid "F2 username"
msgstr "F2-brugernavn"

msgctxt "os2forms_f2"
msgid "The F2 username to act on behalf of"
msgstr "F2-brugernavnet som der skal ageres på vegne af"

msgctxt "os2forms_f2"
msgid "Queue for F2 jobs."
msgstr "Kø til F2-jobs."

msgctxt "os2forms_f2"
msgid ""
"Queue for F2 jobs. <a href=':queue_url'>The queue</a> must be run via "
"Drupal's cron or via <code>drush advancedqueue:queue:process @queue</"
"code> (in a cron job)."
msgstr ""
"Kø til F2-jobs. <a href=':queue_url'>Køen</a> skal behandles via "
"Drupals cron eller med <code>drush advancedqueue:queue:process "
"@queue</code> (i et cron-job)."

msgctxt "os2forms_f2"
msgid "Queue"
msgstr "Kø"

msgctxt "os2forms_f2"
msgid "No queue"
msgstr "Ingen kø"

msgctxt "os2forms_f2"
msgid "Pinged API successfully."
msgstr "Forbindelse opnået."

msgctxt "os2forms_f2"
msgid "Pinging API failed: @message"
msgstr "Fejl under forbindelse til api: @message"

msgctxt "os2forms_f2"
msgid "Additional settings"
msgstr "Yderligere indstillinger"

msgctxt "os2forms_f2"
msgid "Run handler when …"
msgstr "Kør behandler (handler) når …"

