msgid "Case number or ID that uniquely identifies a single case."
msgstr "Sagsnummer eller -id der entydigt identificerer en enkelt sag."

msgctxt "os2forms_f2"
msgid "Matter identifier"
msgstr "Akt-id"

msgctxt "os2forms_f2"
msgid "Matter number or ID that uniquely identifies a single matter."
msgstr "Aktnummer eller -id der entydigt identificerer en enkelt akt."

msgctxt "os2forms_f2"
msgid "Missing case identifier."
msgstr "Manglende sags-id."

msgctxt "os2forms_f2"
msgid "Identifier \"@case_identifier\" does not uniquely identify a case."
msgstr "Id'et \"@case_identifier\" identificerer ikke entydigt en sag."

msgctxt "os2forms_f2"
msgid "Cannot get case by identifier \"@case_identifier\" (@message)."
msgstr "Sag med id \"@case_identifier\" ikke fundet (@message)."

msgctxt "os2forms_f2"
msgid "Missing matter identifier."
msgstr "Manglende akt-id."

msgctxt "os2forms_f2"
msgid "Cannot get matter by identifier \"@matter_identifier\" (@message)."
msgstr "Akt med id \"@matter_identifier\" ikke fundet (@message)."

msgctxt "os2forms_f2"
msgid "Invalid archive target: @target"
msgstr "Ugyldig arkivering: @target"

msgctxt "os2forms_f2"
msgid "Archive on case \"@case_identifier\"."
msgstr "Arkivér på sag \"@case_identifier\"."

msgctxt "os2forms_f2"
msgid "Archive on matter \"@matter_identifier\"."
msgstr "Arkivér på akt \"@matter_identifier\"."

